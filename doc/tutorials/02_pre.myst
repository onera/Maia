                 line_width=1.5, color='black')
# Fixup edge display (better rendering)
actor.mapper.SetResolveCoincidentTopologyToPolygonOffset()


img_3d = plotter.screenshot(return_img=True, window_size=[600,600])


from PIL import Image
new_im = PIL_hstack([Image.fromarray(img) for img in [img_2d, img_3d]],
                    margin=5)

#new_im.save('test.png')
#display(new_im)
from myst_nb import glue
glue("target_fig", new_im)
```

## Performance overview

```{code-cell} python
:tags: [remove-cell, no-parallel]
import numpy as np
import plotly.graph_objects as go

import utils

fig = go.Figure()

x         = [1,2,3,4]#5,6,7,8]
durations = [25.36, 12.84, 9.254, 7.712]#] 9.901, 8.768,  8.236,  8.068]
speedup = [durations[0] / d for d in durations]

fig.add_trace(
  go.Scatter(
    x=x, y=x,
    mode='lines',
    line=dict(color=utils.rtd_warning_title),
    name='ideal',
  )
)
fig.add_trace(
  go.Scatter(
    x=x, y=speedup,
    mode='markers',
    name='result',
    marker=dict(color=utils.rtd_note_title),
  )
)


# 5. finalize figure
fig.update_layout(
xaxis=dict(
  title=dict(
    text='Number of processes',
  ),
  showline=True,
  linecolor='black',
  gridcolor='lightgrey'
),
yaxis=dict(
  title=dict(
    text='Speedup',
  ),
  rangemode="tozero",
  showline=True,
  linecolor='black',
  gridcolor='lightgrey'
),
font=dict(
  family='Courier New, monospace',
  size=14,
),
plot_bgcolor='white',
showlegend=False,
)


fig.write_html('../_static/tuto02_perf_med.html')
```


```{code-cell} python
:tags: [remove-cell, no-parallel]

import numpy as np
